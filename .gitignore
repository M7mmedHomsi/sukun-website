# Tooling
.claude/
node_modules/

# Working files that the site does not serve.
# They stay on disk, they are just not tracked.
uploads/
referencesite.png

# Source media too large or heavy for git.
# The brand book alone is 115 MB, over GitHub's 100 MB hard limit.
assets/brand/Sukun Brand Guidlines/01_Brandbook/
assets/audio/
assets/design mockups/

# Full licensed font files. The site serves its own woff2 subsets; everything
# in the repo is publicly downloadable from the site, and these must not be.
assets/brand/Sukun Brand Guidlines/arabic fonts/
assets/brand/Sukun Brand Guidlines/arabic fonts-*.zip

# Packaged copies of email-handoff/ for sending to the developers.
/email-handoff*.zip

# Optimised WebP is what the site loads; the PNG originals are the source.
assets/images/screens/*.png
assets/images/mascot/*.png
assets/images/*.png

# OS noise
.DS_Store
Thumbs.db
.thumbnail
